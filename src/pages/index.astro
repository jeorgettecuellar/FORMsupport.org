---
import SiteLayout from "../layouts/SiteLayout.astro";

const EMAIL = "partnerships@formsupport.org";
const MAIL_PARTNER = `mailto:${EMAIL}?subject=${encodeURIComponent("Partnership Inquiry")}`;
const MAIL_SUPPORT = `mailto:${EMAIL}?subject=${encodeURIComponent("Support Request")}`;

const stats = [
  { value: "—", label: "Youth supported" },
  { value: "—", label: "Counties served" },
  { value: "—", label: "Community partners" },
  { value: "—", label: "Resources delivered" },
];
---

<SiteLayout title="FORM — Foundation • Opportunity • Resources • Mentorship">

<!-- Utility bar -->
<div class="bg-[color:var(--form-navy)] text-white">
  <div class="max-w-6xl mx-auto px-5 py-2 text-xs flex items-center justify-between">
    <div class="opacity-90">
      Connecting people to verified local support across LA, Orange, Riverside, and San Bernardino
    </div>
    <div class="hidden sm:flex gap-4 nav-bold tracking-wide uppercase">
      <a class="no-underline hover:underline text-white" href={MAIL_SUPPORT}>Get Support</a>
      <a class="no-underline hover:underline text-white" href={MAIL_PARTNER}>Partner</a>
    </div>
  </div>
</div>

<!-- HERO -->
<section class="relative overflow-hidden">
  <div class="absolute inset-0">
    <img src="/hero.jpg" class="h-full w-full object-cover" />
    <div class="absolute inset-0 bg-[color:var(--form-navy)]/70"></div>
  </div>

  <div class="relative max-w-6xl mx-auto px-5 py-20">
    <h1 class="text-5xl text-white nav-bold uppercase">
      Build the foundation. Claim the future.
    </h1>

    <p class="mt-5 text-lg text-white/90">
      FORM advances stability by helping individuals navigate real-life challenges through connection to verified local resources across Southern California.
    </p>

    <div class="mt-8 flex gap-4">
      <a href={MAIL_SUPPORT} class="btn-secondary btn-secondary--on-dark">Get Support</a>
      <a href={MAIL_PARTNER} class="btn-secondary btn-secondary--on-dark">Partner With Us</a>
    </div>
  </div>
</section>

<!-- ABOUT -->
<section id="about" class="py-20">
  <div class="max-w-4xl mx-auto px-5">
    <h2 class="text-4xl nav-bold text-[color:var(--form-navy)] uppercase">About FORM</h2>

    <p class="mt-5 text-lg text-slate-700">
      F.O.R.M compiles and connects individuals to trusted, county-specific resources across Los Angeles, Orange, Riverside, and San Bernardino—making it easier to find real support, close to home.
    </p>

    <a href="/about" class="mt-6 inline-flex nav-bold text-[color:var(--form-orange)]">
      Learn more about FORM →
    </a>
  </div>
</section>

<!-- WHAT WE DO -->
<section class="py-20 bg-slate-50">
  <div class="max-w-6xl mx-auto px-5">
    <h2 class="text-4xl nav-bold text-[color:var(--form-navy)] uppercase">What We Do</h2>

    <p class="mt-3 text-slate-700 max-w-2xl">
      We organize access to housing, education, employment, mental health, and stability services—supporting foster youth, justice-impacted individuals, people experiencing homelessness, and those in recovery.
    </p>

    <a href="/what-we-do" class="mt-5 inline-flex nav-bold text-[color:var(--form-orange)]">
      Explore what we do →
    </a>
  </div>
</section>

<!-- GET INVOLVED SECTION -->
<section class="py-20">
  <div class="max-w-6xl mx-auto px-5 grid md:grid-cols-2 gap-10">

    <!-- LEFT -->
    <div>
      <h2 class="text-4xl nav-bold text-[color:var(--form-navy)] uppercase">Get Involved</h2>

      <p class="mt-4 text-slate-700">
        FORM partners with organizations and individuals who want to make trusted support easier to find and access across our region.
      </p>
    </div>

    <!-- RIGHT CARD -->
    <div class="rounded-3xl bg-[color:var(--form-navy)] p-8 shadow-sm">

      <div class="text-sm nav-bold uppercase text-[color:var(--form-orange)]">
        Partner with FORM
      </div>

      <p class="mt-3 text-lg nav-bold text-[color:var(--form-orange)]">
        Your work matters — and we’d love to help make it more visible and accessible.
      </p>

      <p class="mt-4 text-white/80 text-sm">
        Are you an organization providing housing, education, employment, recovery, legal, or wellness support?
        Reach out to share your services so we can help connect individuals to your trusted resources.
      </p>

      <p class="mt-3 text-white/80 text-sm">
        Together, we can make it easier for people to find the support that already exists in their communities.
      </p>

      <a href={MAIL_PARTNER} class="btn-secondary btn-secondary--on-dark mt-6">
        Get Involved
      </a>

    </div>
  </div>
</section>

<!-- GET SUPPORT -->
<section class="py-20">
  <div class="max-w-6xl mx-auto px-5">
    <div class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm flex justify-between items-center">
      <div>
        <h2 class="text-3xl nav-bold text-[color:var(--form-navy)] uppercase">Need support?</h2>
        <p class="mt-2 text-slate-700">
          If you're looking for resources, start here.
        </p>
      </div>

      <a href={MAIL_SUPPORT} class="btn-primary">
        Get Support
      </a>
    </div>
  </div>
</section>

<!-- FOOTER -->
<footer class="border-t py-10">
  <div class="max-w-6xl mx-auto px-5 text-sm">
    <div class="nav-bold text-[color:var(--form-navy)] uppercase">FORM</div>
    <p class="mt-3 text-slate-700">Build the foundation. Claim the future.</p>

    <p class="mt-3 text-slate-700">
      Email:
      <a href={`mailto:${EMAIL}`} class="hover:underline">
        {EMAIL}
      </a>
    </p>
  </div>
</footer>

</SiteLayout>
