---
import SiteLayout from "../layouts/SiteLayout.astro";

const programs = [
  {
    title: "Resource Navigation",
    desc: "FORM helps individuals identify and access trusted, county-specific support systems across housing, education, employment, healthcare, legal aid, and recovery services. We simplify complex service landscapes by organizing verified local resources and helping individuals understand eligibility, timelines, and next steps—reducing barriers that often prevent people from securing meaningful support.",
  },
  {
    title: "Mentorship & Guidance",
    desc: "Coordinated relationship-based guidance that supports individuals as they move through systems that can often feel overwhelming or inaccessible. Through structured mentorship and practical decision-making support, we help participants set goals, evaluate options, and stay engaged with pathways related to education, employment, recovery, or reentry.",
  },
  {
    title: "Stability & Transition Support",
    desc: "FORM assists individuals navigating critical life transitions such as aging out of care, reentry after incarceration, recovery milestones, housing shifts, or workforce entry to reduce barriers and strengthen long-term outcomes.",
  },
];
---

<SiteLayout title="FORM Programs — Foundation • Opportunity • Resources • Mentorship">

<section class="py-20 bg-slate-50 border-b border-slate-200">
  <div class="max-w-4xl mx-auto px-5">
    <h1 class="text-4xl md:text-5xl nav-bold text-[color:var(--form-navy)] uppercase">
      What We Do
    </h1>

    <p class="mt-5 text-lg text-slate-700">
      F.O.R.M compiles and connects individuals to trusted local resources across Los Angeles,
      Orange, Riverside, and San Bernardino counties. We support foster youth,
      justice-impacted individuals, those experiencing homelessness, and people in recovery
      by organizing access to housing, education, employment, mental health, and stability services.
      Our role is to simplify the search for help—bringing together verified, county-specific support systems.
    </p>
  </div>
</section>

<section class="py-20">
  <div class="max-w-6xl mx-auto px-5">
    <div class="grid md:grid-cols-3 gap-6">
      {programs.map((p) => (
        <div class="bg-white border border-slate-200 rounded-3xl p-7 shadow-sm">
          <div class="h-10 w-10 rounded-xl bg-[color:var(--form-orange)]/15 mb-4"></div>
          <h3 class="text-xl nav-bold text-[color:var(--form-navy)]">{p.title}</h3>
          <p class="mt-3 text-slate-700">{p.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

</SiteLayout>
