---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="What We Do">
  <section class="py-16 md:py-20 lg:py-24">
    <div class="max-w-4xl mx-auto px-5">
      <h1 class="text-3xl md:text-4xl nav-bold text-[color:var(--form-navy)] uppercase">What We Do</h1>

      <p class="mt-6 text-lg text-slate-700">
        We organize access to housing, education, employment, mental health, and stability services—supporting foster youth, justice-impacted individuals, people experiencing homelessness, and those in recovery.
      </p>

      <p class="mt-4 text-slate-700">
        FORM’s role is to simplify the search for help by bringing together verified, county-specific support systems across Southern California.
      </p>
    </div>
  </section>
</SiteLayout>
