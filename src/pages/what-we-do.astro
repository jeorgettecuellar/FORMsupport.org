---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="What We Do">

<section class="py-16 md:py-20 lg:py-24">
  <div class="max-w-4xl mx-auto px-5">

    <h1 class="text-3xl md:text-4xl nav-bold text-[color:var(--form-navy)] uppercase">
      What We Do
    </h1>

    <p class="mt-6 text-lg text-slate-700">
      FORM connects people to trusted support systems across Southern California.
    </p>

    <div class="mt-8 space-y-4 text-slate-700">

      <p>• Housing support</p>
      <p>• Education access</p>
      <p>• Employment pathways</p>
      <p>• Mental health services</p>
      <p>• Stability resources</p>

    </div>

    <p class="mt-6 text-slate-700">
      We focus on making support easier to find by organizing verified local resources into one accessible network.
    </p>

  </div>
</section>

</SiteLayout>
