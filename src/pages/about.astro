---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="About FORM">

<section class="py-16 md:py-20 lg:py-24">
  <div class="max-w-4xl mx-auto px-5">

    <h1 class="text-3xl md:text-4xl nav-bold text-[color:var(--form-navy)] uppercase">
      About FORM
    </h1>

    <p class="mt-6 text-lg text-slate-700">
      F.O.R.M compiles and connects individuals to trusted local resources across Los Angeles, Orange, Riverside, and San Bernardino counties.
    </p>

    <p class="mt-4 text-slate-700">
      We support foster youth, justice-impacted individuals, those experiencing homelessness, and people in recovery by organizing access to housing, education, employment, mental health, and stability services.
    </p>

    <p class="mt-4 text-slate-700">
      Our role is to simplify the search for help—bringing together verified, county-specific support systems.
    </p>

  </div>
</section>

</SiteLayout>
